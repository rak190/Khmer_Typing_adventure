{
  "name": "khmer-typing-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A responsive Khmer-first typing adventure game built with React, TypeScript, Vite, Tailwind CSS, Framer Motion, Recharts, and Firebase-ready demo mode.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "npm run test:typing && npm run test:gamification && npm run test:3d && npm run test:completion",
    "test:3d": "node scripts/threePrototypeTests.mjs",
    "test:typing": "node scripts/typingCoreTests.mjs",
    "test:gamification": "node scripts/gamificationCoreTests.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "deploy": "npm run build && gh-pages -d dist",
    "build:functions": "node scripts/buildFunctions.mjs",
    "test:completion": "node scripts/completionTests.mjs",
    "test:emulators": "npm run build:functions && firebase emulators:exec --project demo-khmer-typing --only auth,firestore,functions \"node scripts/firebaseIntegrationTests.mjs\"",
    "typecheck:functions": "tsc -p tsconfig.functions.json"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.2.4",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "firebase-tools": "^15.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.25.0"
  }
}
