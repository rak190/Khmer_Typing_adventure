rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Direct Firestore student and user access (Option B)
    match /users/{uid} {
      allow read, write: if owns(uid);
      match /{document=**} {
        allow read, write: if owns(uid);
      }
    }

    match /students/{uid} {
      allow read, write: if owns(uid);
      match /{document=**} {
        allow read, write: if owns(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
